# syntax=docker/dockerfile:1
# Baghban — runtime sync from git on every container start.
#
# Build (from docker/):
#   docker build -f Dockerfile.main -t ghcr.io/tariquesani/baghban:master .
#
# Run:
#   docker run --rm -p 6060:6060 \
#     -v baghban-app:/app \
#     -e BAGHBAN_GIT_REPO=https://github.com/tariquesani/baghban.git \
#     -e BAGHBAN_GIT_REF=master \
#     ghcr.io/tariquesani/baghban:master
#
# Optional: BAGHBAN_GIT_TOKEN for private repos.

FROM node:22-bookworm-slim AS node

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    BAGHBAN_APP_SRC=/app \
    BAGHBAN_GIT_REPO=https://github.com/tariquesani/baghban.git \
    BAGHBAN_GIT_REF=master \
    BAGHBAN_HOST=0.0.0.0 \
    BAGHBAN_PORT=6060

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version \
    && npm --version

WORKDIR /app

COPY docker-entrypoint-main.sh /usr/local/bin/baghban-entrypoint-main.sh
RUN sed -i 's/\r$//' /usr/local/bin/baghban-entrypoint-main.sh \
    && chmod +x /usr/local/bin/baghban-entrypoint-main.sh

VOLUME ["/app"]

EXPOSE 6060

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/baghban-entrypoint-main.sh"]
